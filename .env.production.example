# Database (PostgreSQL gerenciado ou container)
DATABASE_URL=postgresql://fluxo:CHANGE_ME_PASSWORD@postgres:5432/fluxo?schema=public
POSTGRES_USER=fluxo
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD
POSTGRES_DB=fluxo

# API Server
NODE_ENV=production
PORT=4000
API_URL=https://fluxopro.example.com
CORS_ORIGIN=https://fluxopro.example.com

# Auth Secrets (Gere chaves seguras de 32+ caracteres)
JWT_SECRET=CHANGE_ME_SECURE_JWT_SECRET_32_CHARS_MIN
REFRESH_TOKEN_SECRET=CHANGE_ME_SECURE_REFRESH_SECRET_32_CHARS_MIN

# Web App
NEXT_PUBLIC_API_URL=/api/v1
PORT_WEB=3000

# Storage S3
S3_ENDPOINT=s3.amazonaws.com
S3_PORT=443
S3_USE_SSL=true
S3_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_SECRET_KEY
S3_BUCKET=fluxopro-prod

# Email (SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=CHANGE_ME_SENDGRID_KEY
EMAIL_FROM=suporte@fluxopro.example.com
