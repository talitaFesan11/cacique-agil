# Database
DATABASE_URL=postgresql://fluxo:fluxo@localhost:5432/fluxo?schema=public

# API Server
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Auth Secrets (exemplos dev)
JWT_SECRET=dev_jwt_secret_must_be_changed_in_prod_32chars_min
REFRESH_TOKEN_SECRET=dev_refresh_secret_must_be_changed_in_prod_32chars_min

# Web App
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
PORT_WEB=3000

# Storage (MinIO S3)
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=fluxopro-dev

# Email (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@fluxopro.local
